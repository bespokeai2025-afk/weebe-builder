# Reverse proxy for Webespoke on EC2. deploy/bootstrap-ec2.sh installs it with __DOMAIN__ replaced.
#
# HTTP only on purpose: `sudo certbot --nginx -d DOMAIN -d www.DOMAIN` then adds the HTTPS
# server, the certificate and the HTTP→HTTPS redirect to this same file. A hand-written
# `listen 443 ssl` block without certificates yet makes `nginx -t` fail.

# Voice calls are WebSockets: pass the upgrade through, and keep ordinary requests on keep-alive.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

upstream webespoke_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    client_max_body_size 25m;

    location / {
        proxy_pass http://webespoke_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # A call's WebSocket stays open for the whole call; streamed replies (SSE) too.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
