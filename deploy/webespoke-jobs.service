# Background jobs — a second copy of the web app that only receives the pg_cron job endpoints
# (campaign executor, video poller, health / stale-call sweeps, ads sync; see nginx config), so a
# heavy job run never slows the website for users.
#   sudo cp deploy/webespoke-jobs.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now webespoke-jobs

[Unit]
Description=Webespoke AI — background jobs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/html/webespoke
Environment=NODE_ENV=production
EnvironmentFile=/var/www/html/webespoke/.env
Environment=VOICE_GATEWAY_MODE=external
ExecStart=/var/www/html/webespoke/node_modules/.bin/srvx serve --prod --entry scripts/prod-entry.mjs --host 127.0.0.1 --port 3002
Restart=on-failure
RestartSec=5
# A job tick can take a while; let it finish on restart.
TimeoutStopSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/html/webespoke
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
